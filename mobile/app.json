{
  "expo": {
    "name": "Bleo",
    "slug": "bleo",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "bleo",
    "userInterfaceStyle": "automatic",
    "description": "Bleo ti accompagna ad aprire la tua ditta individuale in Ticino e nel Grigioni italiano: percorso personale, scadenze e risposte con la fonte ufficiale.",
    "ios": {
      "bundleIdentifier": "ch.bleo.app",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "ch.bleo.app",
      "adaptiveIcon": {
        "backgroundColor": "#E3F0F1",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-sqlite",
      "expo-web-browser",
      "expo-image",
      "expo-font",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Bleo usa la fotocamera per fotografare le tue ricevute e i documenti della tua attività.",
          "photosPermission": "Bleo apre le tue foto per caricare le ricevute e i documenti che scegli.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "backgroundColor": "#FBFAF7",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#111417"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#0F5E6B"
        }
      ],
      "expo-video",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "sitoUrl": "https://bussola-ticino.netlify.app",
      "supabaseUrl": "https://xuqskqdjnuabfzmyecvb.supabase.co",
      "supabaseChiave": "sb_publishable__rsPQ1y_mShdfq7lTOM6xw_8-CU7Jp5"
    }
  }
}
