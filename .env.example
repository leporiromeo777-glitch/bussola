# Copia in .env.local (sviluppo) e nelle variabili d'ambiente di Netlify/Vercel.

# Sito
NEXT_PUBLIC_SITO_URL=http://localhost:3000
# Titolare (impressum, privacy, TWINT): obbligatori prima di pubblicare
NEXT_PUBLIC_TITOLARE_NOME=
NEXT_PUBLIC_TITOLARE_INDIRIZZO=
NEXT_PUBLIC_TITOLARE_EMAIL=

# Supabase: progetto in Svizzera (eu-central-2, Zurigo) o nell'UE
# (eu-central-1, Francoforte). Chiavi in Project Settings > API Keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Solo server: mai con prefisso NEXT_PUBLIC_
SUPABASE_SECRET_KEY=
# Dove sono i dati, per l'informativa sulla privacy: "svizzera" se il progetto
# è a Zurigo (eu-central-2), "ue" se è a Francoforte (eu-central-1).
NEXT_PUBLIC_SUPABASE_REGIONE_DATI=

# Verifica anti-robot sul link di accesso (Cloudflare Turnstile): chiave del
# sito. La chiave segreta va in Supabase > Authentication > Attack Protection.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Claude API (chat con fonti). Solo server.
ANTHROPIC_API_KEY=
# Modello della chat: predefinito claude-sonnet-5-5
ANTHROPIC_MODEL=
# Modello di «Raccontami la tua idea» nel questionario: predefinito claude-haiku-5-5
ANTHROPIC_MODEL_RACCONTO=
# Modelli delle altre funzioni con l'AI (vuoto = predefinito):
# lettera fotografata claude-sonnet-5-5, testi pronti e nome della ditta claude-haiku-5-5
ANTHROPIC_MODEL_LETTERA=
ANTHROPIC_MODEL_TESTI=
ANTHROPIC_MODEL_NOME=
# Lettura delle ricevute di «I tuoi conti» (foto, PDF, email): predefinito lo stesso modello economico di ANTHROPIC_MODEL_RACCONTO
ANTHROPIC_MODEL_RICEVUTE=

# Email transazionali (conferma lista d'attesa). Facoltativo: senza, la
# lista d'attesa salva l'iscrizione e la conferma si fa a mano.
RESEND_API_KEY=
EMAIL_MITTENTE="Bussola <ciao@example.ch>"

# «I tuoi conti»: ricezione delle email inoltrate (Resend, facoltativo).
# Dominio di ricezione: quello <id>.resend.app del tuo account Resend o un tuo
# dominio con il record MX verso Resend. Gli indirizzi sono ricevute-<codice>@<dominio>.
RESEND_DOMINIO_RICEZIONE=
# Segreto di firma del webhook «email.received» (whsec_...), dalla pagina del
# webhook su Resend. Il webhook punta a https://<dominio del sito>/api/conti/email-in
# Serve anche RESEND_API_KEY (con accesso alla ricezione) e SUPABASE_SECRET_KEY.
RESEND_WEBHOOK_SECRET=

# Statistiche senza cookie (facoltativo), es. bussola.ch
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
